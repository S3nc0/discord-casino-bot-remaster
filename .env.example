# Copy to .env on your own machine and fill in real values. Never commit .env.
# All values below are placeholders.

# Discord application (Developer Portal)
DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-with-client-secret

# Comma-separated snowflakes
ALLOWED_GUILD_IDS=000000000000000000
OWNER_IDS=000000000000000000
TEST_GUILD_ID=000000000000000000

# 1 = new guilds wait for owner approval before they can play
REQUIRE_APPROVAL=1

# Game day boundaries (JST = 9)
UTC_OFFSET_HOURS=9

# Long random string used to sign session tokens (at least 32 bytes)
SESSION_SECRET=replace-with-long-random-string

# Public origin of the API behind the tunnel, without trailing slash
PUBLIC_API_ORIGIN=https://api.example.com

# Default announce channel; per-guild override is stored in the DB
ANNOUNCE_CHANNEL_ID=000000000000000000
