{
  "name": "@casino/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Discord Activity front end.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/check-bundle.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "dev:mock": "VITE_MOCK_DISCORD=1 vite",
    "screens:life": "node scripts/screens-life.mjs"
  },
  "dependencies": {
    "@casino/shared": "workspace:*",
    "@casino/ui": "workspace:*",
    "@discord/embedded-app-sdk": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "playwright-core": "1.65.1",
    "vite": "8.3.6"
  }
}
