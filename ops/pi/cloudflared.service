[Unit]
Description=Cloudflare Tunnel for Discord Casino API
After=network-online.target discord-casino.service
Wants=network-online.target

[Service]
Type=simple
User=casino
Group=casino
ExecStart=/usr/bin/env cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
