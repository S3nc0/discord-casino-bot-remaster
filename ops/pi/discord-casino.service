[Unit]
Description=Discord Casino Server (Fastify, Socket.io, Bot, Scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=casino
Group=casino
WorkingDirectory=/opt/discord-casino
Environment=NODE_ENV=production
EnvironmentFile=/opt/discord-casino/.env
ExecStart=/usr/bin/env node --max-old-space-size=192 --enable-source-maps /opt/discord-casino/apps/server/dist/main.js
Restart=on-failure
RestartSec=5
MemoryMax=320M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discord-casino/data

[Install]
WantedBy=multi-user.target
