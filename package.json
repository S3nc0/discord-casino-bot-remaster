{
  "name": "discord-casino-remaster",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter @casino/shared i18n:check",
    "dev:server": "pnpm --filter @casino/server exec tsup --watch src --watch ../../packages/shared/src --watch ../../packages/shared/i18n --watch ../../packages/domain/src --onSuccess \"(cd ../.. && exec node --env-file-if-exists=.env --max-old-space-size=192 --enable-source-maps apps/server/dist/main.js)\"",
    "dev:tunnel": "cloudflared tunnel --config \"${CLOUDFLARED_CONFIG:-ops/cloudflared/config.example.yml}\" run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
